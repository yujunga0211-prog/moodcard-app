{
  "name": "moodcard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:openai": "tsx --env-file-if-exists=.env.local scripts/check-openai.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "seed:songs": "tsx --env-file-if-exists=.env.local scripts/seed-songs.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
